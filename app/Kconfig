menu "Hubble Network Satellite Sample options"

config SAMPLE_PROVIDE_SAT_BOARD_SUPPORT
    bool "Provide satellite board suport for test purpose"
    help
	Targets that support satellite must select it, otherwise
	board APIs will be mocked in the sample.

config SAMPLE_SAT_TX_INTERVAL_SECONDS
    int "Time between transmissions in seconds"
    default 10
    help
	Time from the start of one satellite packet transmission to the
	start of the next, in seconds.

config SAMPLE_SAT_TX_START_DELAY_SECONDS
    int "Delay from power-on to the first transmission in seconds"
    default 0
    help
	Lets the board be powered on well before a predicted satellite pass
	without using up sequence numbers while no satellite is in view.

config SAMPLE_SAT_TX_WINDOW_SECONDS
    int "How long to keep transmitting, in seconds (0 = forever)"
    default 0
    help
	After the start delay, transmit for this long and then stop. Each
	packet uses one of the 1,024 sequence numbers a key gets per day,
	so the build fails if the window would need more than that.

config SAMPLE_SAT_PAYLOAD_SIZE
    int "Payload bytes in each satellite packet (4, 9 or 13)"
    default 13
    range 4 13
    help
	Bytes 0-3 carry the packet's sequence number, so 4 is the smallest
	size this sample sends. The SDK only accepts 0, 4, 9 or 13; larger
	payloads take more symbols, and so longer, on the air.

config SAMPLE_SAT_TX_TIMING
    bool "Measure how long each satellite packet takes to send"
    select TIMING_FUNCTIONS
    help
	Bench measurement: wraps hubble_sat_board_packet_send() at link
	time and times it, and the whole hubble_sat_packet_send() call,
	with the timing API (the DWT CPU cycle counter on Cortex-M when
	CORTEX_M_DWT is on). Prints one line per packet with printk.
	Enable with -DEXTRA_CONF_FILE=timing.conf.

config SAMPLE_HUBBLE_KEY
    string "Base64-encoded Hubble master key"
    default ""
    help
	Base64-encoded master key provisioned at build time. Pass it with
	west build ... -- -DCONFIG_SAMPLE_HUBBLE_KEY=\"<base64 key>\".
	If left empty, an all-zero placeholder is used: the sample still
	builds but will not produce valid advertisements until a real key
	is supplied.

endmenu

source "Kconfig.zephyr"

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"
